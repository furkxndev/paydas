# Paydaş - Frontend ortam değişkenleri
# Bu dosyayı ".env" olarak kopyalayıp değerleri kendi ortamınıza göre düzenleyin.
# EXPO_PUBLIC_ önekli değişkenler istemci paketine gömülür; gizli anahtar koymayın.

# NestJS backend adresi.
# Fiziksel cihazda test ederken "localhost" ÇALIŞMAZ; telefon kendi localhost'una bakar.
# Bilgisayarınızın LAN IP'sini yazın (macOS: ipconfig getifaddr en0).
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api

# false = gerçek backend, true = cihaz içi mock servis (backend gerekmez).
EXPO_PUBLIC_USE_MOCK_API=false

# Expo push token alabilmek için EAS proje kimliği (expo.dev üzerinden alınır)
EXPO_PUBLIC_EAS_PROJECT_ID=
