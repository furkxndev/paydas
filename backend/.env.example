# Paydaş - Backend ortam değişkenleri
# Bu dosyayı ".env" olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun.
# .env dosyası sürüm kontrolüne EKLENMEZ (bkz. .gitignore).

# --- Uygulama ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Virgülle ayrılmış origin listesi; * tüm kaynaklara izin verir (yalnızca geliştirme)
CORS_ORIGINS=*

# --- Veritabanı (docker-compose ile aynı olmalı) ---
DB_HOST=localhost
# Ana makinede PostgreSQL kuruluysa (ör. Postgres.app) 5432 dolu olabilir.
# Bu değer hem docker-compose yayın portu hem de API'nin bağlanacağı porttur.
DB_PORT=5433
DB_USERNAME=paydas
DB_PASSWORD=degistir_bu_sifreyi
DB_NAME=paydas
# Şema migration ile yönetilir; bu bayrak KAPALI kalmalıdır.
# Açmak (true) TypeORM'un şemayı otomatik hizalamasına ve veri kaybına yol açabilir.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Kimlik doğrulama ---
# En az 32 karakter olmalı. Üretim için rastgele üretin:
#   openssl rand -base64 48
JWT_SECRET=bu_degeri_degistirin_en_az_32_karakter_olmali
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=bu_refresh_degerini_de_degistirin_en_az_32_karakter
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# --- Şifre sıfırlama / e-posta (SMTP) ---
# Boş bırakılırsa e-posta gönderilmez; bağlantılar sunucu loguna yazılır (geliştirme).
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Paydaş <noreply@paydas.app>
# Kayıt sonrası e-posta doğrulaması zorunlu olsun mu (SMTP kurulmadan açmayın)
REQUIRE_EMAIL_VERIFICATION=false

# --- İstek limiti (kaba kuvvet koruması) ---
# Dakikada izin verilen istek sayısı
THROTTLE_LIMIT=120
# Giriş/kayıt/şifre sıfırlama uçları için daha sıkı limit
THROTTLE_AUTH_LIMIT=10

# --- Bildirimler ---
# Expo push için erişim anahtarı (expo.dev > Access Tokens). Boş bırakılabilir.
EXPO_ACCESS_TOKEN=
# Fatura hatırlatmalarının varsayılan saati (0-23)
REMINDER_HOUR=10
